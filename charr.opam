# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A compiler for a large subset of C, targeting x86-64 assembly"
description:
  "charr is a compiler for a large subset of the C programming language, written in OCaml. It compiles C source to x86-64 assembly through a multi-stage pipeline: lexing, parsing, semantic analysis and type checking, a three-address intermediate representation, and code generation. It also includes optimisation passes comprising constant folding, copy propagation, dead store elimination, and unreachable code elimination. Inspired by Nora Sandler's book Writing a C Compiler."
maintainer: ["Joshua Nunn <gh@joshua.nu>"]
authors: ["Joshua Nunn <gh@joshua.nu>"]
license: "MIT"
homepage: "https://github.com/joshuanunn/charr"
bug-reports: "https://github.com/joshuanunn/charr/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "ocamlformat"
  "dune" {>= "3.20"}
  "menhir"
  "ppx_deriving"
  "ppx_expect"
  "ppx_inline_test"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/joshuanunn/charr.git"
x-maintenance-intent: ["(latest)"]
