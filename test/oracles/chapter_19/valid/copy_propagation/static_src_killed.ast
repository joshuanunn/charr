(Ast.Program
   [(Ast.VarDecl
       { Ast.name = (Ast.Identifier "x");
         init = (Some (Ast.Constant (Ast.ConstInt 1l))); var_type = Ast.Int;
         storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "f"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.S
                       (Ast.Expression
                          (Ast.Assignment ((Ast.Var (Ast.Identifier "x")),
                             (Ast.Constant (Ast.ConstInt 4l))))));
                     (Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 0l))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "target"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.D
                       (Ast.VarDecl
                          { Ast.name = (Ast.Identifier "y");
                            init = (Some (Ast.Var (Ast.Identifier "x")));
                            var_type = Ast.Int; storage = None }));
                     (Ast.S
                        (Ast.Expression
                           Ast.FunctionCall {name = (Ast.Identifier "f");
                             args = []}));
                     (Ast.S (Ast.Return (Ast.Var (Ast.Identifier "y"))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "main"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.S
                       Ast.If {
                         cond_exp =
                         Ast.Binary {op = Ast.NotEqual;
                           left =
                           Ast.FunctionCall {
                             name = (Ast.Identifier "target"); args = []};
                           right = (Ast.Constant (Ast.ConstInt 1l))};
                         then_smt =
                         (Ast.Compound
                            (Ast.Block
                               [(Ast.S
                                   (Ast.Return
                                      (Ast.Constant (Ast.ConstInt 1l))))
                                 ]));
                         else_smt = None});
                     (Ast.S
                        Ast.If {
                          cond_exp =
                          Ast.Binary {op = Ast.NotEqual;
                            left = (Ast.Var (Ast.Identifier "x"));
                            right = (Ast.Constant (Ast.ConstInt 4l))};
                          then_smt =
                          (Ast.Compound
                             (Ast.Block
                                [(Ast.S
                                    (Ast.Return
                                       (Ast.Constant (Ast.ConstInt 2l))))
                                  ]));
                          else_smt = None});
                     (Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 0l))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          })
     ])
