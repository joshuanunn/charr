(Ast.Program
   [(Ast.VarDecl
       { Ast.name = (Ast.Identifier "global"); init = None;
         var_type = Ast.Int; storage = None });
     (Ast.VarDecl
        { Ast.name = (Ast.Identifier "flag");
          init = (Some (Ast.Constant (Ast.ConstInt 1l))); var_type = Ast.Int;
          storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "f"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.S
                       (Ast.Expression
                          (Ast.Assignment (
                             (Ast.Var (Ast.Identifier "global")),
                             (Ast.Constant (Ast.ConstInt 100l))))));
                     (Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 0l))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "main"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.S
                       (Ast.Expression
                          (Ast.Assignment (
                             (Ast.Var (Ast.Identifier "global")),
                             (Ast.Constant (Ast.ConstInt 0l))))));
                     (Ast.S
                        Ast.If {cond_exp = (Ast.Var (Ast.Identifier "flag"));
                          then_smt =
                          (Ast.Compound
                             (Ast.Block
                                [(Ast.S
                                    (Ast.Expression
                                       Ast.FunctionCall {
                                         name = (Ast.Identifier "f");
                                         args = []}))
                                  ]));
                          else_smt = None});
                     (Ast.S (Ast.Return (Ast.Var (Ast.Identifier "global"))))
                     ]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          })
     ])
