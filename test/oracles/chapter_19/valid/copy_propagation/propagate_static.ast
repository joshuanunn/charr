(Ast.Program
   [(Ast.VarDecl
       { Ast.name = (Ast.Identifier "x");
         init = (Some (Ast.Constant (Ast.ConstInt 0l))); var_type = Ast.Int;
         storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "target"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.S
                       (Ast.Expression
                          (Ast.Assignment ((Ast.Var (Ast.Identifier "x")),
                             (Ast.Constant (Ast.ConstInt 10l))))));
                     (Ast.S (Ast.Return (Ast.Var (Ast.Identifier "x"))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "main"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.D
                       (Ast.VarDecl
                          { Ast.name = (Ast.Identifier "result");
                            init =
                            (Some Ast.FunctionCall {
                                    name = (Ast.Identifier "target");
                                    args = []});
                            var_type = Ast.Int; storage = None }));
                     (Ast.S
                        Ast.If {
                          cond_exp =
                          Ast.Binary {op = Ast.NotEqual;
                            left = (Ast.Var (Ast.Identifier "result"));
                            right = (Ast.Constant (Ast.ConstInt 10l))};
                          then_smt =
                          (Ast.Compound
                             (Ast.Block
                                [(Ast.S
                                    (Ast.Return
                                       (Ast.Constant (Ast.ConstInt 1l))))
                                  ]));
                          else_smt = None});
                     (Ast.S
                        Ast.If {
                          cond_exp =
                          Ast.Binary {op = Ast.NotEqual;
                            left = (Ast.Var (Ast.Identifier "x"));
                            right = (Ast.Constant (Ast.ConstInt 10l))};
                          then_smt =
                          (Ast.Compound
                             (Ast.Block
                                [(Ast.S
                                    (Ast.Return
                                       (Ast.Constant (Ast.ConstInt 2l))))
                                  ]));
                          else_smt = None});
                     (Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 0l))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          })
     ])
