           dst = (Ir.Var "main.tmp.3")};
         Ir.JumpIfZero {condition = (Ir.Var "main.tmp.3");
           target = "main.if.en.4"};
         (Ir.Return (Ir.Constant (Ctype.ConstInt 2l)));
         (Ir.Label "main.if.en.4");
         (Ir.Return (Ir.Constant (Ctype.ConstInt 0l)))]};
     Ir.StaticVariable {name = "x"; global = true; t = Ctype.Int;
       init = (Ctype.IntInit 0l)}
     ])
