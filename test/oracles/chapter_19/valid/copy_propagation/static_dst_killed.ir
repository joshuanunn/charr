        (Ir.Return (Ir.Constant (Ctype.ConstInt 0l)))]};
     Ir.Function {name = "target"; global = true; params = [];
       body =
       [Ir.Copy {src = (Ir.Constant (Ctype.ConstInt 3l)); dst = (Ir.Var "x")};
         Ir.FunCall {fun_name = "update_x"; args = [];
