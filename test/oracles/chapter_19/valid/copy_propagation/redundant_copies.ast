(Ast.Program
   [(Ast.FunDecl
       { Ast.name = (Ast.Identifier "target");
         params =
         [(Ast.Identifier "flag"); (Ast.Identifier "flag2");
           (Ast.Identifier "y")];
         body =
         (Some (Ast.Block
                  [(Ast.D
                      (Ast.VarDecl
                         { Ast.name = (Ast.Identifier "x");
                           init = (Some (Ast.Var (Ast.Identifier "y")));
                           var_type = Ast.Int; storage = None }));
                    (Ast.S
                       Ast.If {cond_exp = (Ast.Var (Ast.Identifier "flag"));
                         then_smt =
                         (Ast.Compound
                            (Ast.Block
                               [(Ast.S
                                   (Ast.Expression
                                      (Ast.Assignment (
                                         (Ast.Var (Ast.Identifier "y")),
                                         (Ast.Var (Ast.Identifier "x"))))))
                                 ]));
                         else_smt = None});
                    (Ast.S
                       Ast.If {cond_exp = (Ast.Var (Ast.Identifier "flag2"));
                         then_smt =
                         (Ast.Compound
                            (Ast.Block
                               [(Ast.S
                                   (Ast.Expression
                                      (Ast.Assignment (
                                         (Ast.Var (Ast.Identifier "x")),
                                         (Ast.Var (Ast.Identifier "y"))))))
                                 ]));
                         else_smt = None});
                    (Ast.S
                       (Ast.Return
                          Ast.Binary {op = Ast.Add;
                            left = (Ast.Var (Ast.Identifier "x"));
                            right = (Ast.Var (Ast.Identifier "y"))}))
                    ]));
         fun_type =
         Ast.FunType {params = [Ast.Int; Ast.Int; Ast.Int]; ret = Ast.Int};
         storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "main"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.S
                       (Ast.Return
                          Ast.FunctionCall {name = (Ast.Identifier "target");
                            args =
                            [(Ast.Constant (Ast.ConstInt 0l));
                              (Ast.Constant (Ast.ConstInt 1l));
                              (Ast.Constant (Ast.ConstInt 10l))]}))
                     ]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          })
     ])
