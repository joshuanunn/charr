(Ast.Program
   [(Ast.FunDecl
       { Ast.name = (Ast.Identifier "callee");
         params = [(Ast.Identifier "a"); (Ast.Identifier "b")];
         body =
         (Some (Ast.Block
                  [(Ast.S
                      (Ast.Return
                         Ast.Binary {op = Ast.Add;
                           left = (Ast.Var (Ast.Identifier "a"));
                           right = (Ast.Var (Ast.Identifier "b"))}))
                    ]));
         fun_type = Ast.FunType {params = [Ast.Int; Ast.Int]; ret = Ast.Int};
         storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "target");
          params = [(Ast.Identifier "flag")];
          body =
          (Some (Ast.Block
                   [(Ast.D
                       (Ast.VarDecl
                          { Ast.name = (Ast.Identifier "x"); init = None;
                            var_type = Ast.Int; storage = (Some Ast.Static) }));
                     (Ast.D
                        (Ast.VarDecl
                           { Ast.name = (Ast.Identifier "y"); init = None;
                             var_type = Ast.Int; storage = (Some Ast.Static)
                             }));
                     (Ast.S
                        Ast.If {cond_exp = (Ast.Var (Ast.Identifier "flag"));
                          then_smt =
                          (Ast.Compound
                             (Ast.Block
                                [(Ast.S
                                    (Ast.Expression
                                       (Ast.Assignment (
                                          (Ast.Var (Ast.Identifier "y")),
                                          (Ast.Constant (Ast.ConstInt 20l))))));
                                  (Ast.S
                                     (Ast.Expression
                                        (Ast.Assignment (
                                           (Ast.Var (Ast.Identifier "x")),
                                           (Ast.Var (Ast.Identifier "y"))))))
                                  ]));
                          else_smt =
                          (Some (Ast.Compound
                                   (Ast.Block
                                      [(Ast.S
                                          (Ast.Expression
                                             (Ast.Assignment (
                                                (Ast.Var (Ast.Identifier "y")),
                                                (Ast.Constant
                                                   (Ast.ConstInt 100l))
                                                ))));
                                        (Ast.S
                                           (Ast.Expression
                                              (Ast.Assignment (
                                                 (Ast.Var
                                                    (Ast.Identifier "x")),
                                                 (Ast.Var
                                                    (Ast.Identifier "y"))
                                                 ))))
                                        ])))});
                     (Ast.S
                        (Ast.Return
                           Ast.FunctionCall {
                             name = (Ast.Identifier "callee");
                             args =
                             [(Ast.Var (Ast.Identifier "x"));
                               (Ast.Var (Ast.Identifier "y"))]}))
                     ]));
          fun_type = Ast.FunType {params = [Ast.Int]; ret = Ast.Int};
          storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "main"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.D
                       (Ast.VarDecl
                          { Ast.name = (Ast.Identifier "result");
                            init =
                            (Some Ast.FunctionCall {
                                    name = (Ast.Identifier "target");
                                    args = [(Ast.Constant (Ast.ConstInt 0l))]});
                            var_type = Ast.Int; storage = None }));
                     (Ast.S
                        Ast.If {
                          cond_exp =
                          Ast.Binary {op = Ast.NotEqual;
                            left = (Ast.Var (Ast.Identifier "result"));
                            right = (Ast.Constant (Ast.ConstInt 200l))};
                          then_smt =
                          (Ast.Return (Ast.Constant (Ast.ConstInt 1l)));
                          else_smt = None});
                     (Ast.S
                        (Ast.Expression
                           (Ast.Assignment (
                              (Ast.Var (Ast.Identifier "result")),
                              Ast.FunctionCall {
                                name = (Ast.Identifier "target");
                                args = [(Ast.Constant (Ast.ConstInt 1l))]}
                              ))));
                     (Ast.S
                        Ast.If {
                          cond_exp =
                          Ast.Binary {op = Ast.NotEqual;
                            left = (Ast.Var (Ast.Identifier "result"));
                            right = (Ast.Constant (Ast.ConstInt 40l))};
                          then_smt =
                          (Ast.Return (Ast.Constant (Ast.ConstInt 2l)));
                          else_smt = None});
                     (Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 0l))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          })
     ])
