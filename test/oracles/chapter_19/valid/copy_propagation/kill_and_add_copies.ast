(Ast.Program
   [(Ast.VarDecl
       { Ast.name = (Ast.Identifier "globvar"); init = None;
         var_type = Ast.Int; storage = (Some Ast.Static) });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "set_globvar");
          params = [(Ast.Identifier "i")];
          body =
          (Some (Ast.Block
                   [(Ast.S
                       (Ast.Expression
                          (Ast.Assignment (
                             (Ast.Var (Ast.Identifier "globvar")),
                             (Ast.Var (Ast.Identifier "i"))))));
                     (Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 0l))))]));
          fun_type = Ast.FunType {params = [Ast.Int]; ret = Ast.Int};
          storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "callee");
          params = [(Ast.Identifier "a"); (Ast.Identifier "b")];
          body =
          (Some (Ast.Block
                   [(Ast.S
                       (Ast.Return
                          Ast.Binary {op = Ast.Add;
                            left = (Ast.Var (Ast.Identifier "a"));
                            right = (Ast.Var (Ast.Identifier "b"))}))
                     ]));
          fun_type = Ast.FunType {params = [Ast.Int; Ast.Int]; ret = Ast.Int};
          storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "target");
          params = [(Ast.Identifier "param")];
          body =
          (Some (Ast.Block
                   [(Ast.D
                       (Ast.VarDecl
                          { Ast.name = (Ast.Identifier "x");
                            init = (Some (Ast.Var (Ast.Identifier "param")));
                            var_type = Ast.Int; storage = None }));
                     (Ast.S
                        (Ast.Expression
                           Ast.FunctionCall {
                             name = (Ast.Identifier "set_globvar");
                             args = [(Ast.Var (Ast.Identifier "x"))]}));
                     (Ast.D
                        (Ast.VarDecl
                           { Ast.name = (Ast.Identifier "y");
                             init = (Some (Ast.Var (Ast.Identifier "x")));
                             var_type = Ast.Int; storage = None }));
                     (Ast.S
                        (Ast.Expression
                           (Ast.Assignment ((Ast.Var (Ast.Identifier "x")),
                              (Ast.Constant (Ast.ConstInt 10l))))));
                     (Ast.S
                        (Ast.Return
                           Ast.FunctionCall {
                             name = (Ast.Identifier "callee");
                             args =
                             [(Ast.Var (Ast.Identifier "x"));
                               (Ast.Var (Ast.Identifier "y"))]}))
                     ]));
          fun_type = Ast.FunType {params = [Ast.Int]; ret = Ast.Int};
          storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "main"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.S
                       Ast.If {
                         cond_exp =
                         Ast.Binary {op = Ast.NotEqual;
                           left =
                           Ast.FunctionCall {
                             name = (Ast.Identifier "target");
                             args = [(Ast.Constant (Ast.ConstInt 4l))]};
                           right = (Ast.Constant (Ast.ConstInt 14l))};
                         then_smt =
                         (Ast.Compound
                            (Ast.Block
                               [(Ast.S
                                   (Ast.Return
                                      (Ast.Constant (Ast.ConstInt 1l))))
                                 ]));
                         else_smt = None});
                     (Ast.S
                        Ast.If {
                          cond_exp =
                          Ast.Binary {op = Ast.NotEqual;
                            left = (Ast.Var (Ast.Identifier "globvar"));
                            right = (Ast.Constant (Ast.ConstInt 4l))};
                          then_smt =
                          (Ast.Compound
                             (Ast.Block
                                [(Ast.S
                                    (Ast.Return
                                       (Ast.Constant (Ast.ConstInt 2l))))
                                  ]));
                          else_smt = None});
                     (Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 0l))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          })
     ])
