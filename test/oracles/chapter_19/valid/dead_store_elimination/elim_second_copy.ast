(Ast.Program
   [(Ast.FunDecl
       { Ast.name = (Ast.Identifier "callee");
         params = [(Ast.Identifier "arg")];
         body =
         (Some (Ast.Block
                  [(Ast.S
                      (Ast.Return
                         Ast.Binary {op = Ast.Multiply;
                           left = (Ast.Var (Ast.Identifier "arg"));
                           right = (Ast.Constant (Ast.ConstInt 2l))}))
                    ]));
         fun_type = Ast.FunType {params = [Ast.Int]; ret = Ast.Int};
         storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "target");
          params = [(Ast.Identifier "arg"); (Ast.Identifier "flag")];
          body =
          (Some (Ast.Block
                   [(Ast.D
                       (Ast.VarDecl
                          { Ast.name = (Ast.Identifier "x");
                            init =
                            (Some Ast.Binary {op = Ast.Add;
                                    left = (Ast.Var (Ast.Identifier "arg"));
                                    right = (Ast.Constant (Ast.ConstInt 1l))});
                            var_type = Ast.Int; storage = None }));
                     (Ast.S
                        Ast.If {cond_exp = (Ast.Var (Ast.Identifier "flag"));
                          then_smt =
                          (Ast.Compound
                             (Ast.Block
                                [(Ast.S
                                    (Ast.Expression
                                       (Ast.Assignment (
                                          (Ast.Var (Ast.Identifier "x")),
                                          Ast.Binary {op = Ast.Subtract;
                                            left =
                                            (Ast.Var (Ast.Identifier "arg"));
                                            right =
                                            (Ast.Constant (Ast.ConstInt 1l))}
                                          ))))
                                  ]));
                          else_smt = None});
                     (Ast.D
                        (Ast.VarDecl
                           { Ast.name = (Ast.Identifier "y");
                             init =
                             (Some Ast.FunctionCall {
                                     name = (Ast.Identifier "callee");
                                     args = [(Ast.Var (Ast.Identifier "x"))]});
                             var_type = Ast.Int; storage = None }));
                     (Ast.S
                        (Ast.Expression
                           (Ast.Assignment ((Ast.Var (Ast.Identifier "x")),
                              (Ast.Constant (Ast.ConstInt 100l))))));
                     (Ast.S (Ast.Return (Ast.Var (Ast.Identifier "y"))))]));
          fun_type = Ast.FunType {params = [Ast.Int; Ast.Int]; ret = Ast.Int};
          storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "main"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.S
                       Ast.If {
                         cond_exp =
                         Ast.Binary {op = Ast.NotEqual;
                           left =
                           Ast.FunctionCall {
                             name = (Ast.Identifier "target");
                             args =
                             [(Ast.Constant (Ast.ConstInt 4l));
                               (Ast.Constant (Ast.ConstInt 0l))]};
                           right = (Ast.Constant (Ast.ConstInt 10l))};
                         then_smt =
                         (Ast.Compound
                            (Ast.Block
                               [(Ast.S
                                   (Ast.Return
                                      (Ast.Constant (Ast.ConstInt 1l))))
                                 ]));
                         else_smt = None});
                     (Ast.S
                        Ast.If {
                          cond_exp =
                          Ast.Binary {op = Ast.NotEqual;
                            left =
                            Ast.FunctionCall {
                              name = (Ast.Identifier "target");
                              args =
                              [(Ast.Constant (Ast.ConstInt 3l));
                                (Ast.Constant (Ast.ConstInt 1l))]};
                            right = (Ast.Constant (Ast.ConstInt 4l))};
                          then_smt =
                          (Ast.Compound
                             (Ast.Block
                                [(Ast.S
                                    (Ast.Return
                                       (Ast.Constant (Ast.ConstInt 2l))))
                                  ]));
                          else_smt = None});
                     (Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 0l))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          })
     ])
