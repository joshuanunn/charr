(Ast.Program
   [(Ast.VarDecl
       { Ast.name = (Ast.Identifier "a");
         init = (Some (Ast.Constant (Ast.ConstInt 1l))); var_type = Ast.Int;
         storage = None });
     (Ast.VarDecl
        { Ast.name = (Ast.Identifier "b");
          init = (Some (Ast.Constant (Ast.ConstInt 2l))); var_type = Ast.Int;
          storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "target"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.D
                       (Ast.VarDecl
                          { Ast.name = (Ast.Identifier "unused");
                            init =
                            (Some Ast.Binary {op = Ast.Multiply;
                                    left = (Ast.Var (Ast.Identifier "a"));
                                    right =
                                    Ast.Unary {op = Ast.Negate;
                                      exp = (Ast.Var (Ast.Identifier "b"))}});
                            var_type = Ast.Int; storage = None }));
                     (Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 5l))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "main"); params = [];
