                              (Ast.LiteralInt 100)))));
                     (Ast.S (Ast.Return (Ast.Var (Ast.Identifier "y.4"))))]));
          storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "main"); params = [];
