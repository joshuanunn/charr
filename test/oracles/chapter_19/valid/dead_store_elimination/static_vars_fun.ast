(Ast.Program
   [(Ast.VarDecl
       { Ast.name = (Ast.Identifier "x");
         init = (Some (Ast.Constant (Ast.ConstInt 100l)));
         var_type = Ast.Int; storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "get_x"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.S (Ast.Return (Ast.Var (Ast.Identifier "x"))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "main"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.S
                       (Ast.Expression
                          (Ast.Assignment ((Ast.Var (Ast.Identifier "x")),
                             (Ast.Constant (Ast.ConstInt 5l))))));
                     (Ast.D
                        (Ast.VarDecl
                           { Ast.name = (Ast.Identifier "result");
                             init =
                             (Some Ast.FunctionCall {
                                     name = (Ast.Identifier "get_x");
                                     args = []});
                             var_type = Ast.Int; storage = None }));
                     (Ast.S
                        (Ast.Expression
                           (Ast.Assignment ((Ast.Var (Ast.Identifier "x")),
                              (Ast.Constant (Ast.ConstInt 10l))))));
                     (Ast.S (Ast.Return (Ast.Var (Ast.Identifier "result"))))
                     ]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          })
     ])
