(Ir.Program
   [Ir.Function {name = "get_x"; global = true; params = [];
      body = [(Ir.Return (Ir.Var "x"))]};
     Ir.Function {name = "main"; global = true; params = [];
       body =
       [Ir.Copy {src = (Ir.Constant (Ctype.ConstInt 5l)); dst = (Ir.Var "x")};
         Ir.FunCall {fun_name = "get_x"; args = [];
           dst = (Ir.Var "main.tmp.0")};
         Ir.Copy {src = (Ir.Constant (Ctype.ConstInt 10l));
           dst = (Ir.Var "x")};
         (Ir.Return (Ir.Var "main.tmp.0"))]};
     Ir.StaticVariable {name = "x"; global = true; t = Ctype.Int;
       init = (Ctype.IntInit 100l)}
     ])
