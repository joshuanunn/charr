(Ast.Program
   [(Ast.FunDecl
       { Ast.name = (Ast.Identifier "callee"); params = [];
         body =
         (Some (Ast.Block
                  [(Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 4l))))]));
         fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
         });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "callee2"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 5l))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "target");
          params = [(Ast.Identifier "flag")];
          body =
          (Some (Ast.Block
                   [(Ast.D
                       (Ast.VarDecl
                          { Ast.name = (Ast.Identifier "x");
                            init = (Some (Ast.Constant (Ast.ConstInt 10l)));
                            var_type = Ast.Int; storage = None }));
                     (Ast.S
                        Ast.If {cond_exp = (Ast.Var (Ast.Identifier "flag"));
                          then_smt =
                          (Ast.Compound
                             (Ast.Block
                                [(Ast.S
                                    (Ast.Expression
                                       (Ast.Assignment (
                                          (Ast.Var (Ast.Identifier "x")),
                                          Ast.FunctionCall {
                                            name = (Ast.Identifier "callee");
                                            args = []}
                                          ))))
                                  ]));
                          else_smt =
                          (Some (Ast.Compound
                                   (Ast.Block
                                      [(Ast.S
                                          (Ast.Expression
                                             (Ast.Assignment (
                                                (Ast.Var (Ast.Identifier "x")),
                                                Ast.FunctionCall {
                                                  name =
                                                  (Ast.Identifier "callee2");
                                                  args = []}
                                                ))))
                                        ])))});
                     (Ast.S (Ast.Return (Ast.Var (Ast.Identifier "x"))))]));
          fun_type = Ast.FunType {params = [Ast.Int]; ret = Ast.Int};
          storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "main"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.S
                       Ast.If {
                         cond_exp =
                         Ast.Binary {op = Ast.NotEqual;
                           left =
                           Ast.FunctionCall {
                             name = (Ast.Identifier "target");
                             args = [(Ast.Constant (Ast.ConstInt 1l))]};
                           right = (Ast.Constant (Ast.ConstInt 4l))};
                         then_smt =
                         (Ast.Compound
                            (Ast.Block
                               [(Ast.S
                                   (Ast.Return
                                      (Ast.Constant (Ast.ConstInt 1l))))
                                 ]));
                         else_smt = None});
                     (Ast.S
                        Ast.If {
                          cond_exp =
                          Ast.Binary {op = Ast.NotEqual;
                            left =
                            Ast.FunctionCall {
                              name = (Ast.Identifier "target");
                              args = [(Ast.Constant (Ast.ConstInt 0l))]};
                            right = (Ast.Constant (Ast.ConstInt 5l))};
                          then_smt =
                          (Ast.Compound
                             (Ast.Block
                                [(Ast.S
                                    (Ast.Return
                                       (Ast.Constant (Ast.ConstInt 2l))))
                                  ]));
                          else_smt = None});
                     (Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 0l))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          })
     ])
