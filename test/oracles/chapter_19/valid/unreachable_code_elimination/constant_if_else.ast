(Ast.Program
   [(Ast.FunDecl
       { Ast.name = (Ast.Identifier "callee"); params = [];
         body =
         (Some (Ast.Block
                  [(Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 0l))))]));
         fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
         });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "target"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.D
                       (Ast.VarDecl
                          { Ast.name = (Ast.Identifier "x"); init = None;
                            var_type = Ast.Int; storage = None }));
                     (Ast.S
                        Ast.If {cond_exp = (Ast.Constant (Ast.ConstInt 0l));
                          then_smt =
                          (Ast.Expression
                             (Ast.Assignment ((Ast.Var (Ast.Identifier "x")),
                                Ast.FunctionCall {
                                  name = (Ast.Identifier "callee"); args = []}
                                )));
                          else_smt =
                          (Some (Ast.Expression
                                   (Ast.Assignment (
                                      (Ast.Var (Ast.Identifier "x")),
                                      (Ast.Constant (Ast.ConstInt 40l))))))});
                     (Ast.S
                        (Ast.Return
                           Ast.Binary {op = Ast.Add;
                             left = (Ast.Var (Ast.Identifier "x"));
                             right = (Ast.Constant (Ast.ConstInt 5l))}))
                     ]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "main"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.S
                       (Ast.Return
                          Ast.FunctionCall {name = (Ast.Identifier "target");
                            args = []}))
                     ]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          })
     ])
