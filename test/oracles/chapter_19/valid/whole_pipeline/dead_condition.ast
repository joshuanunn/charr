(Ast.Program
   [(Ast.VarDecl
       { Ast.name = (Ast.Identifier "flag");
         init = (Some (Ast.Constant (Ast.ConstInt 1l))); var_type = Ast.Int;
         storage = None });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "target"); params = [];
          body =
          (Some (Ast.Block
                   [(Ast.D
                       (Ast.VarDecl
                          { Ast.name = (Ast.Identifier "x");
                            init = (Some (Ast.Constant (Ast.ConstInt 2l)));
                            var_type = Ast.Int; storage = None }));
                     (Ast.S
                        Ast.If {cond_exp = (Ast.Var (Ast.Identifier "flag"));
                          then_smt =
                          (Ast.Compound
                             (Ast.Block
                                [(Ast.S
                                    (Ast.Expression
                                       (Ast.Assignment (
                                          (Ast.Var (Ast.Identifier "x")),
                                          (Ast.Constant (Ast.ConstInt 20l))))))
