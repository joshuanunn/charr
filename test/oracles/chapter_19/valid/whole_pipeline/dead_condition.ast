                          else_smt = None});
                     (Ast.S
                        Ast.If {cond_exp = (Ast.Var (Ast.Identifier "x"));
                          then_smt = Ast.Null; else_smt = None});
                     (Ast.S (Ast.Return (Ast.Constant (Ast.ConstInt 10l))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          });
     (Ast.FunDecl
        { Ast.name = (Ast.Identifier "main"); params = [];
