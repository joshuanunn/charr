                              Ast.Binary {op = Ast.Add;
                                left = (Ast.Var (Ast.Identifier "x"));
                                right = (Ast.Constant (Ast.ConstInt 5l))}
                              ))));
                     (Ast.S (Ast.Return (Ast.Var (Ast.Identifier "z"))))]));
          fun_type = Ast.FunType {params = []; ret = Ast.Int}; storage = None
          });
     (Ast.FunDecl
