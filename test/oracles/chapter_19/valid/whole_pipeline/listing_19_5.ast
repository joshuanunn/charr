                            var_type = Ast.Int; storage = None }));
                     (Ast.D
                        (Ast.VarDecl
                           { Ast.name = (Ast.Identifier "z"); init = None;
                             var_type = Ast.Int; storage = None }));
                     (Ast.S
                        Ast.If {
                          cond_exp =
                          Ast.Binary {op = Ast.Subtract;
                            left = (Ast.Constant (Ast.ConstInt 4l));
                            right = (Ast.Var (Ast.Identifier "x"))};
                          then_smt =
                          (Ast.Compound
                             (Ast.Block
                                [(Ast.S
                                    (Ast.Expression
                                       (Ast.Assignment (
                                          (Ast.Var (Ast.Identifier "x")),
                                          (Ast.Constant (Ast.ConstInt 3l))))))
