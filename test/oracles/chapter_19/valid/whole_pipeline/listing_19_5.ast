                             (Ast.Block
                                [(Ast.S
                                    (Ast.Expression
                                       (Ast.Assignment (
                                          (Ast.Var (Ast.Identifier "z")),
                                          (Ast.Constant (Ast.ConstInt 10l))))))
                                  ]));
                          else_smt = None});
                     (Ast.S
                        (Ast.Expression
