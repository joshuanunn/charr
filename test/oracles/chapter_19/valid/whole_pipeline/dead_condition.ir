(Ir.Program
   [Ir.Function {name = "target"; global = true; params = [];
      body = [(Ir.Return (Ir.Constant (Ctype.ConstInt 10l)))]};
     Ir.Function {name = "main"; global = true; params = [];
       body =
       [Ir.FunCall {fun_name = "target"; args = [];
          dst = (Ir.Var "main.tmp.0")};
         (Ir.Return (Ir.Var "main.tmp.0"))]};
     Ir.StaticVariable {name = "flag"; global = true; t = Ctype.Int;
       init = (Ctype.IntInit 1l)}
     ])
