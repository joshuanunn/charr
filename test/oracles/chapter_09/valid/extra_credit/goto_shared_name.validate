                    (Ast.S
                       (Ast.Return
                          { Ast.e = (Ast.Constant (Ctype.ConstInt 0l));
                            typ = (Some Ctype.Int) }));
                    (Ast.S
                       (Ast.Label ((Ast.GotoLabel "foo.0"),
                          (Ast.Return
