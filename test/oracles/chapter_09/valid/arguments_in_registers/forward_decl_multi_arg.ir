(Ir.Program
   [Ir.Function {name = "main"; global = true; params = [];
      body =
      [Ir.FunCall {fun_name = "foo";
         args =
         [(Ir.Constant (Ctype.ConstInt 2l));
           (Ir.Constant (Ctype.ConstInt 1l))];
         dst = (Ir.Var "main.tmp.0")};
        (Ir.Return (Ir.Var "main.tmp.0"))]};
     Ir.Function {name = "foo"; global = true; params = ["x.2"; "y.3"];
       body =
       [Ir.Binary {op = Ir.Subtract; src1 = (Ir.Var "x.2");
          src2 = (Ir.Var "y.3"); dst = (Ir.Var "foo.tmp.0")};
         (Ir.Return (Ir.Var "foo.tmp.0"))]}
     ])
