(Ir.Program
   [Ir.Function {name = "sub"; global = true; params = ["a.0"; "b.1"];
      body =
      [Ir.Binary {op = Ir.Subtract; src1 = (Ir.Var "a.0");
         src2 = (Ir.Var "b.1"); dst = (Ir.Var "sub.tmp.0")};
        (Ir.Return (Ir.Var "sub.tmp.0"))]};
     Ir.Function {name = "main"; global = true; params = [];
       body =
       [Ir.FunCall {fun_name = "sub";
          args =
          [(Ir.Constant (Ctype.ConstInt 3l));
            (Ir.Constant (Ctype.ConstInt 1l))];
          dst = (Ir.Var "main.tmp.1")};
         (Ir.Return (Ir.Var "main.tmp.1"))]}
     ])
