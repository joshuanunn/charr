(Ir.Program
   [Ir.Function {name = "a"; global = true; params = [];
      body = [(Ir.Return (Ir.Constant (Ctype.ConstInt 1l)))]};
     Ir.Function {name = "b"; global = true; params = ["a.0"];
       body = [(Ir.Return (Ir.Var "a.0"))]};
     Ir.Function {name = "main"; global = true; params = [];
       body =
       [Ir.FunCall {fun_name = "a"; args = []; dst = (Ir.Var "main.tmp.0")};
         Ir.FunCall {fun_name = "b";
           args = [(Ir.Constant (Ctype.ConstInt 2l))];
           dst = (Ir.Var "main.tmp.1")};
         Ir.Binary {op = Ir.Add; src1 = (Ir.Var "main.tmp.0");
           src2 = (Ir.Var "main.tmp.1"); dst = (Ir.Var "main.tmp.2")};
         (Ir.Return (Ir.Var "main.tmp.2"))]}
     ])
