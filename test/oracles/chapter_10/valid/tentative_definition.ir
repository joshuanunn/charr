        (Ir.Label "loop.st.1");
        Ir.Binary {op = Ir.LessThan; src1 = (Ir.Var "i.0");
          src2 = (Ir.Constant (Ctype.ConstInt 5l)); dst = (Ir.Var "tmp.0")};
        Ir.JumpIfZero {condition = (Ir.Var "tmp.0"); target = "loop.br.1"};
        Ir.Binary {op = Ir.Add; src1 = (Ir.Var "foo");
          src2 = (Ir.Constant (Ctype.ConstInt 1l)); dst = (Ir.Var "tmp.1")};
        Ir.Copy {src = (Ir.Var "tmp.1"); dst = (Ir.Var "foo")};
        Ir.Binary {op = Ir.Add; src1 = (Ir.Var "i.0");
          src2 = (Ir.Constant (Ctype.ConstInt 1l)); dst = (Ir.Var "tmp.2")};
        Ir.Copy {src = (Ir.Var "tmp.2"); dst = (Ir.Var "i.0")};
        Ir.Jump {target = "loop.st.1"}; (Ir.Label "loop.br.1");
        (Ir.Return (Ir.Var "foo"))];
      frame =
