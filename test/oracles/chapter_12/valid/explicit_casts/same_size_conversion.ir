(Ir.Program
   [Ir.Function {name = "uint_to_int"; global = true;
      params = ["ui.0"; "expected.1"];
      body =
      [Ir.Copy {src = (Ir.Var "ui.0"); dst = (Ir.Var "uint_to_int.tmp.0")};
        Ir.Binary {op = Ir.Equal; src1 = (Ir.Var "uint_to_int.tmp.0");
          src2 = (Ir.Var "expected.1"); dst = (Ir.Var "uint_to_int.tmp.1")};
        (Ir.Return (Ir.Var "uint_to_int.tmp.1"))]};
     Ir.Function {name = "int_to_uint"; global = true;
       params = ["i.2"; "expected.3"];
       body =
       [Ir.Copy {src = (Ir.Var "i.2"); dst = (Ir.Var "int_to_uint.tmp.0")};
         Ir.Binary {op = Ir.Equal; src1 = (Ir.Var "int_to_uint.tmp.0");
           src2 = (Ir.Var "expected.3"); dst = (Ir.Var "int_to_uint.tmp.1")};
         (Ir.Return (Ir.Var "int_to_uint.tmp.1"))]};
     Ir.Function {name = "ulong_to_long"; global = true;
       params = ["ul.4"; "expected.5"];
       body =
       [Ir.Copy {src = (Ir.Var "ul.4"); dst = (Ir.Var "ulong_to_long.tmp.0")};
         Ir.Binary {op = Ir.Equal; src1 = (Ir.Var "ulong_to_long.tmp.0");
           src2 = (Ir.Var "expected.5"); dst = (Ir.Var "ulong_to_long.tmp.1")};
         (Ir.Return (Ir.Var "ulong_to_long.tmp.1"))]};
     Ir.Function {name = "long_to_ulong"; global = true;
       params = ["l.6"; "expected.7"];
       body =
       [Ir.Copy {src = (Ir.Var "l.6"); dst = (Ir.Var "long_to_ulong.tmp.0")};
         Ir.Binary {op = Ir.Equal; src1 = (Ir.Var "long_to_ulong.tmp.0");
           src2 = (Ir.Var "expected.7"); dst = (Ir.Var "long_to_ulong.tmp.1")};
         (Ir.Return (Ir.Var "long_to_ulong.tmp.1"))]};
     Ir.Function {name = "main"; global = true; params = [];
       body =
       [Ir.FunCall {fun_name = "int_to_uint";
          args =
          [(Ir.Constant (Ctype.ConstInt 10l));
            (Ir.Constant (Ctype.ConstUInt 10l))];
          dst = (Ir.Var "main.tmp.0")};
         Ir.Unary {op = Ir.Not; src = (Ir.Var "main.tmp.0");
           dst = (Ir.Var "main.tmp.1")};
         Ir.JumpIfZero {condition = (Ir.Var "main.tmp.1");
           target = "main.if.en.2"};
         (Ir.Return (Ir.Constant (Ctype.ConstInt 1l)));
         (Ir.Label "main.if.en.2");
         Ir.FunCall {fun_name = "uint_to_int";
           args =
           [(Ir.Constant (Ctype.ConstUInt 10l));
             (Ir.Constant (Ctype.ConstInt 10l))];
           dst = (Ir.Var "main.tmp.3")};
         Ir.Unary {op = Ir.Not; src = (Ir.Var "main.tmp.3");
           dst = (Ir.Var "main.tmp.4")};
         Ir.JumpIfZero {condition = (Ir.Var "main.tmp.4");
           target = "main.if.en.5"};
         (Ir.Return (Ir.Constant (Ctype.ConstInt 2l)));
         (Ir.Label "main.if.en.5");
         Ir.FunCall {fun_name = "long_to_ulong";
           args =
           [(Ir.Constant (Ctype.ConstLong -1000L));
             (Ir.Constant (Ctype.ConstULong -1000L))];
           dst = (Ir.Var "main.tmp.7")};
         Ir.Unary {op = Ir.Not; src = (Ir.Var "main.tmp.7");
           dst = (Ir.Var "main.tmp.8")};
         Ir.JumpIfZero {condition = (Ir.Var "main.tmp.8");
           target = "main.if.en.9"};
         (Ir.Return (Ir.Constant (Ctype.ConstInt 3l)));
         (Ir.Label "main.if.en.9");
         Ir.FunCall {fun_name = "ulong_to_long";
           args =
           [(Ir.Constant (Ctype.ConstULong -1000L));
             (Ir.Constant (Ctype.ConstLong -1000L))];
           dst = (Ir.Var "main.tmp.11")};
         Ir.Unary {op = Ir.Not; src = (Ir.Var "main.tmp.11");
           dst = (Ir.Var "main.tmp.12")};
         Ir.JumpIfZero {condition = (Ir.Var "main.tmp.12");
           target = "main.if.en.13"};
         (Ir.Return (Ir.Constant (Ctype.ConstInt 4l)));
         (Ir.Label "main.if.en.13");
         (Ir.Return (Ir.Constant (Ctype.ConstInt 0l)))]}
     ])
